# The world server (stage B1): `protogaea-server` as a systemd service.
#
# Install:
#   useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin protogaea
#   install -D -m 0755 protogaea-server /opt/protogaea/protogaea-server
#   install -D -m 0600 /dev/null /etc/protogaea/server.env   # optionally PROTOGAEA_PASSWORD=... in it
#   cp protogaea-server.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now protogaea-server
#
# The world, its snapshots and the database live in /var/lib/protogaea-server; it resumes from there after a restart.
# The limits below keep it a polite neighbor to other services on the same machine.

[Unit]
Description=Protogaea world server
After=network-online.target
Wants=network-online.target

[Service]
User=protogaea
Group=protogaea
EnvironmentFile=-/etc/protogaea/server.env
ExecStart=/opt/protogaea/protogaea-server --seed 5 --data /var/lib/protogaea-server --listen 0.0.0.0:8081 --epoch-seconds 300
StateDirectory=protogaea-server
StateDirectoryMode=0750
Restart=on-failure
RestartSec=10

# Resource limits.
Nice=10
CPUQuota=50%
MemoryMax=1G
TasksMax=64
IOSchedulingClass=idle

# Sandboxing.
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
